{
    "name": "Data Science Template",
    "dockerComposeFile": [
        "../docker-compose.yml"
    ],
    "service": "development",

    "workspaceFolder": "/app",

    "customizations": {
        "vscode": {
            "extensions": [
                "streetsidesoftware.code-spell-checker",
                "streetsidesoftware.code-spell-checker-spanish",
                "eamodio.gitlens",
                "ms-python.python", // Paquete principal de Python en VS Code
                "ms-python.vscode-pylance", // Servidor de lenguaje de Python
                "ms-toolsai.jupyter", // Soporte para Jupyter Notebooks
                "ms-toolsai.datawrangler",
                "njpwerner.autodocstring",
                "redhat.vscode-yaml",
                "charliermarsh.ruff", // Linter y formateador de Python
                "ms-toolsai.tensorboard",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3",
                "python.analysis.extraPaths": ["/app/src"]
            }
        }
    },
    // En desarrollo es más sencillo para acceder a /dev/bus/usb
    "remoteUser": "root", 
    "runArgs": ["--gpus", "all"]
}